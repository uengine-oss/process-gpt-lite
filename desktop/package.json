{
  "name": "process-gpt-lite-desktop",
  "productName": "Process GPT Lite",
  "version": "0.2.1",
  "private": true,
  "description": "Process GPT Lite desktop app: a window around a Lite server (company address or a local install)",
  "author": "uEngine",
  "license": "SEE LICENSE IN ../LICENSE",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "PGL_DESKTOP_DEV=1 electron .",
    "test": "node --test --test-timeout=600000 test/*.test.js",
    "icon": "python3 scripts/make-icon.py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "smoke": "node scripts/smoke-packaged.js",
    "postinstall": "node scripts/pty-helper.js"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
