{
  "version": 1,
  "about": "What a champion folder never uploads, and the shapes of known keys looked for in what is left (design §2.4, §7.1). File names and token shapes only — no meaning is read. The desktop (desktop/src/runner/sync.js) and the server (server/lib/folders) use the same file; desktop/src/runner/secret-shapes.json is a copy of server/lib/folders/secret-shapes.json (a desktop unit test keeps them equal). Not secret by name: '.key' (a Keynote presentation is a .key too — a text private key in it is still caught by its shape), public keys (*.pub). Level 'check' rather than 'block' for an AWS access key id and a Google API key (both are often public: documentation's example ids, a web app's browser key). The single source is server/lib/folders/secret-shapes.json. limits: textMaxBytes — text read for key shapes (larger files and files with a NUL byte are not read); largeFileBytes — one file; pushMaxBytes — one push as sent; pushMaxCommits — new commits in one push; headMaxFiles · headMaxBytes — the pushed snapshot's whole tree, before compression. The server refuses a push over any of them.",
  "limits": {
    "textMaxBytes": 1048576,
    "largeFileBytes": 52428800,
    "pushMaxBytes": 209715200,
    "pushMaxCommits": 20,
    "headMaxFiles": 20000,
    "headMaxBytes": 1073741824
  },
  "groups": {
    "secret": {
      "names": [".env", ".npmrc", ".netrc", ".pypirc", "credentials.json", ".git-credentials", ".pgpass"],
      "prefixes": [".env.", "id_rsa", "id_ed25519", "id_ecdsa", "id_dsa", "service-account"],
      "extensions": [".pem", ".p12", ".pfx", ".keystore", ".jks"],
      "dirs": [".aws", ".ssh", ".gnupg"],
      "paths": [
        ".claude/.credentials.json",
        ".codex/auth.json"
      ],
      "dirPaths": [],
      "keep": [".env.example", ".env.sample", ".env.template", ".env.dist", "id_rsa.pub", "id_ed25519.pub", "id_ecdsa.pub", "id_dsa.pub"]
    },
    "personal": {
      "names": [],
      "prefixes": [],
      "extensions": [],
      "dirs": [".vscode", ".idea"],
      "paths": [
        ".claude/settings.local.json",
        ".codex/history.jsonl",
        ".cursor/mcp.json"
      ],
      "dirPaths": [".claude/projects", ".claude/todos", ".claude/worktrees", ".claude/shell-snapshots", ".claude/statsig", ".codex/sessions", ".codex/log"],
      "keep": []
    },
    "rebuildable": {
      "names": [".DS_Store", "Thumbs.db", "desktop.ini"],
      "prefixes": [],
      "extensions": [".pyc"],
      "dirs": ["node_modules", ".venv", "venv", "__pycache__", ".next", "target", ".gradle", ".pytest_cache", ".mypy_cache", ".turbo", ".parcel-cache"],
      "paths": [

      ],
      "dirPaths": [],
      "keep": []
    }
  },
  "check": {
    "about": "files that go up only when the person says so (they are listed as flagged, left out by default)",
    "paths": [
      {"path": ".mcp.json", "reason": "runs_config"}
    ]
  },
  "shapes": [
    {"id": "private_key", "level": "block", "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----"},
    {"id": "aws_access_key", "level": "check", "pattern": "\\b(?:AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}\\b"},
    {"id": "github_token", "level": "block", "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b"},
    {"id": "github_pat", "level": "block", "pattern": "\\bgithub_pat_[A-Za-z0-9_]{60,255}\\b"},
    {"id": "gitlab_token", "level": "block", "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}\\b"},
    {"id": "slack_token", "level": "block", "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,}\\b"},
    {"id": "slack_webhook", "level": "block", "pattern": "https://hooks\\.slack\\.com/services/[A-Za-z0-9_/]{20,}"},
    {"id": "anthropic_key", "level": "block", "pattern": "\\bsk-ant-[a-z]+\\d{2}-[A-Za-z0-9_-]{40,}"},
    {"id": "openai_key", "level": "block", "pattern": "\\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{40,}"},
    {"id": "google_api_key", "level": "check", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b"},
    {"id": "google_oauth_secret", "level": "block", "pattern": "\\bGOCSPX-[A-Za-z0-9_-]{28}\\b"},
    {"id": "stripe_key", "level": "block", "pattern": "\\b(?:sk|rk)_live_[A-Za-z0-9]{24,}\\b"},
    {"id": "npm_token", "level": "block", "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b"},
    {"id": "pypi_token", "level": "block", "pattern": "\\bpypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,}"},
    {"id": "huggingface_token", "level": "block", "pattern": "\\bhf_[A-Za-z0-9]{34,}\\b"},
    {"id": "lite_folder_token", "level": "block", "pattern": "\\bpgf1\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{16,}"},
    {"id": "lite_device_token", "level": "block", "pattern": "\\bpld1_[A-Za-z0-9_-]{43}"},
    {"id": "signed_token", "level": "check", "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{16,}"},
    {"id": "url_credentials", "level": "check", "pattern": "\\b[a-z][a-z0-9+.-]{1,20}://[^\\s/:@'\"]{1,64}:[^\\s/@'\"]{6,}@[^\\s/'\"]+"},
    {"id": "env_assignment", "level": "check", "kind": "assignment", "about": "a NAME=value line in the dotenv · shell form whose value is long and evenly mixed (no space, not a path, not a reference)", "minLength": 20, "minEntropy": 3.6, "minClasses": 2}
  ]
}
