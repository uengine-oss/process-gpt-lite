          { "@call": "required", "args": { "value": { "@path": "/form/decision" } } },
          { "@call": "required", "args": { "value": { "@path": "/form/opinion" } } } ] } }, "message": "검토 결과와 의견을 채워 주세요." }] }
    ],
    "dataModel": { "form": { "decision": [], "amount": "26070000", "due": "", "checked": false, "opinion": "" } }
