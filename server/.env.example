# Process GPT Lite BFF settings. Copy to server/.env (never commit it).
# Values not set here are read from the process-gpt checkout's .env (PGPT_ROOT/.env):
# ANON_KEY, SERVICE_ROLE_KEY, POSTGRES_PASSWORD, OPENAI_API_KEY, LLM_PROXY_URL …
# PGPT_ROOT itself must come from the shell environment (default: backends/process-gpt,
# then ~/process-gpt).

# ── 기본 / basics ─────────────────────────────────────────────
PRO_PORT=8787
PRO_PUBLIC_URL=http://localhost:5180
PRO_TENANT_ID=localhost
# 실제 배포 시 로컬 데모 로그인(코드 000000)을 끕니다. / Disable the demo login in production.
# PRO_DEMO_LOGIN=0

# ── process-gpt 백엔드 / backends ─────────────────────────────
PRO_SUPABASE_URL=http://127.0.0.1:54321
PRO_DB_HOST=127.0.0.1
PRO_DB_PORT=54322
PRO_DEEPAGENTS_URL=http://127.0.0.1:8888
PRO_COMPLETION_URL=http://127.0.0.1:8099
PRO_CLI_AGENT_URL=http://127.0.0.1:8890
# context-router (services/context-router, :8895). 비우면 deepagents 로 바로 보냄
PRO_CONTEXT_ROUTER_URL=
PRO_MCP_HUB_URL=http://127.0.0.1:8500
# mcp-hub 검증기는 컨테이너 안에서, deepagents 는 호스트에서 커넥터 MCP 에 접속
# PRO_MCP_VALIDATE_BASE=http://host.docker.internal:8787
# PRO_MCP_RUNTIME_BASE=http://localhost:8787
# PRO_MEMENTO_URL=

# ── LLM (OpenAI 호환) ─────────────────────────────────────────
PRO_LLM_BASE_URL=https://api.openai.com/v1
PRO_LLM_API_KEY=
PRO_LLM_MODEL=gpt-6-luna
PRO_LLM_FAST_MODEL=gpt-4.1-mini
# PRO_LLM_TRACE=/tmp/pgpt-llm-trace.log

# ── 사용량 한도·요금제 (LiteLLM, lib/llmKeys.js · lib/plans) ──────────
# 켜면 모든 모델 호출이 그 사람·회사의 LiteLLM 키로 나가고, 회사 요금제(설정 › 사용량·요금제)가 한도가 된다.
# PRO_LLM_BASE_URL 은 그 LiteLLM(…/v1). LiteLLM 은 같은 Postgres 의 전용 스키마·역할로(?schema=litellm) —
# public 에 붙이면 LiteLLM 이 기동하면서 모르는 테이블을 지운다.
# PRO_LLM_KEYS=litellm
# PRO_LITELLM_URL=http://127.0.0.1:4000
# PRO_LITELLM_ADMIN_KEY=
# PRO_LLM_KEY_SECRET=            # 사람·회사별 키를 만드는 비밀(바꾸면 키가 모두 새로 만들어진다)
# PRO_LLM_PRO_MODEL=             # Pro 등급 모델(없으면 PRO_LLM_MODEL)
# PRO_PLAN_CATALOG=uengine       # uengine(크레딧·원화, 기본) | claude | hark
# PRO_PLAN_UNIT_SESSION_USD=0.4  # Free 한 세션(5시간)의 모델 비용
# PRO_PLAN_UNIT_WEEK_USD=2.4     # Free 한 주
# PRO_PLAN_UNIT_MONTH_USD=6      # (hark) Free 한 달
# PRO_CREDIT_KRW=10 PRO_FX_KRW_PER_USD=1450 PRO_MARKUP=2.2   # (uengine) 1크레딧 = 원가 × 환율 × 마크업 ÷ ₩10
# PRO_PLAN_SESSION_SHARE=0.25    # (uengine) 5시간 세션 = 좌석 크레딧의 25%
# PRO_PLAN_PERSON_SHARE=2        # (uengine) 한 사람의 한 달 = 좌석 크레딧의 2배
# PRO_PLAN_SCALE=1               # 모든 한도에 곱함(시험용)
PRO_BROWSER_GATES=on

# ── Google 로그인·메일 연결 / Google sign-in & mail ───────────
# Redirect URI: http://localhost:5180/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PRO_MAIL_POLL_SECONDS=300

# ── 보관함 / credential vault ──────────────────────────────────
# 32 bytes base64. Unset → a 0600 keyring file server/.vault-keyring.json is created.
# 운영에서는 KMS / Secret Manager 로 주입하세요.
PRO_VAULT_KEK=
PRO_VAULT_KEK_RETIRED=
# PRO_VAULT_KEYRING=server/.vault-keyring.json

# ── 예약 작업 / schedules (pg_cron → pg_net → this server) ─────
PRO_CRON_CALLBACK=http://host.docker.internal:8787
# 반드시 바꾸세요 / change this
PRO_CRON_SECRET=change-me

# ── 에이전트 작업실 / agent workroom ──────────────────────────
# 터미널을 여는 열쇠(로그인에 더해 필요). 비우면 터미널을 열지 않습니다.
PRO_TERMINAL_KEY=
PRO_CLI_WORKSPACE_ROOT=/tmp/cli-agent-ws
PRO_CLAUDE_BIN=claude
# 공유 폴더 저장소 위치 (unset = ~/pgpt-folders)
PRO_FOLDERS_ROOT=

# ── 문서 / documents ──────────────────────────────────────────
# office-mcp generate_hwpx 기본 템플릿 URL
PRO_HWPX_TEMPLATE_URL=
# 이음오피스 편집기 호스트(process-gpt-office-host): 열린 문서를 대화로 고치는 office_live_* MCP
# PRO_OFFICE_HOST_URL=http://127.0.0.1:5390
# 고객 메일이 요청한 제안서 초안: office-mcp(generate_hwpx) 주소와 템플릿(설계 제안은 fixtures/interior-proposal-template.hwpx)
# PRO_OFFICE_MCP_URL=http://127.0.0.1:1192
# PRO_PROPOSAL_TEMPLATE_URL=

# ── ArtCraft (artcraft/README.md) ─────────────────────────────
# PRO_ARTCRAFT_ROOT=artcraft
# PRO_CRAFT_WEB_ROOT=artcraft/web
# PRO_CADCRAFT_CLI=cadcraft-cli
# PRO_VECTORCRAFT_CLI=vectorcraft-cli
# PRO_PHOTOCRAFT_CLI=photocraft-cli
# PRO_SOUNDCRAFT_CLI=soundcraft-cli
# PRO_FILMCRAFT_CLI=filmcraft-cli
