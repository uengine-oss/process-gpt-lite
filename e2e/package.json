{
  "name": "pgpt-pro-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Process GPT Lite (pgpt-pro) regression suite: smoke / feature / agent tiers",
  "type": "module",
  "scripts": {
    "test:smoke": "RT_REPORT=smoke playwright test --project=smoke",
    "test:feature": "RT_REPORT=feature playwright test --project=feature",
    "test:agent": "RT_REPORT=agent RT_WORKERS=${RT_WORKERS:-2} playwright test --project=agent",
    "test:all": "RT_REPORT=all playwright test --project=smoke --project=feature --project=agent",
    "report": "playwright show-report reports/${RT_REPORT:-all}/html",
    "cleanup": "node lib/cleanup-cli.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "undici": "^7.30.1",
    "ws": "^8.22.0"
  }
}
