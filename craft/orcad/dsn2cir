#!/usr/bin/env node
// dsn2cir file.dsn [-o out.cir] [--view 회로도] [--bom] [--json]
//   OrCAD Capture .DSN → PSpice 넷리스트. 넷리스트는 표준 출력(또는 -o), 경고는 표준 오류로.
//   --view  최상위 회로도 이름 (없으면 파일에 적힌 것)
//   --bom   넷리스트 대신 부품 표(CSV)
//   --json  넷리스트 대신 parts, nets, stats, warnings 를 JSON 으로
// 부품이 다른 .DSN 의 회로도를 가리키면 그 파일도 읽어 펼친다(부품의 Implementation Path 기준, 입력 파일 옆과 그 아래 폴더에서 찾는다).
// 바이너리는 ORCAD2JSON 환경 변수, 없으면 ../../../artcraft/orcad2json, 그래도 없으면 PATH 에서 찾는다.
import { spawnSync } from 'node:child_process'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { dsnToNetlist } from './dsn2cir.mjs'

const here = path.dirname(fileURLToPath(import.meta.url))

function fail(message, code = 2) {
  process.stderr.write(`dsn2cir: ${message}\n`)
  process.exit(code)
}

const usage = 'usage: dsn2cir file.dsn [-o out.cir] [--view name] [--bom] [--json]\n'

const args = process.argv.slice(2)
let input = null, output = null, wantBom = false, wantJson = false, view
for (let i = 0; i < args.length; i++) {
  const a = args[i]
  if (a === '-o' || a === '--output') {
    output = args[++i]
    if (!output) fail('-o 다음에 파일 이름이 필요해요', 1)
  } else if (a === '--view') {
    view = args[++i]
    if (!view) fail('--view 다음에 회로도 이름이 필요해요', 1)
  } else if (a === '--bom') wantBom = true
  else if (a === '--json') wantJson = true
  else if (a === '-h' || a === '--help') { process.stdout.write(usage); process.exit(0) }
  else if (a.startsWith('-')) fail(`모르는 옵션이에요: ${a}\n${usage}`, 1)
  else if (input) fail(`입력 파일은 하나만 받아요\n${usage}`, 1)
  else input = a
}
if (!input) { process.stderr.write(usage); process.exit(1) }

const candidates = [process.env.ORCAD2JSON, path.resolve(here, '../../../artcraft/orcad2json'), path.resolve(here, 'orcad2json')].filter(Boolean)
const binary = candidates.find((c) => fs.existsSync(c)) || 'orcad2json'

const parse = (file) => spawnSync(binary, [file], { encoding: 'utf8', maxBuffer: 1 << 30, stdio: ['ignore', 'pipe', 'pipe'] })

const run = parse(input)
if (run.error) fail(`orcad2json 을 실행하지 못했어요 (${binary}): ${run.error.code === 'ENOENT' ? 'craft/orcad/build.sh 로 먼저 만드세요' : run.error.message}`, 4)
if (run.stderr) process.stderr.write(run.stderr)
if (run.status !== 0) process.exit(run.status ?? 4)

// 아래 회로도가 든 다른 설계 파일을 찾는다. Windows 경로이고 대소문자가 다를 수 있다.
const others = new Map()
function findFile(dir, name) {
  try {
    const hit = fs.readdirSync(dir).find((f) => f.toLowerCase() === name.toLowerCase())
    return hit ? path.join(dir, hit) : null
  } catch { return null }
}
function resolve(implPath) {
  if (!implPath) return null
  const rel = implPath.replace(/\\/g, '/')
  const base = path.dirname(input), name = path.basename(rel)
  const dirs = [path.resolve(base, path.dirname(rel)), base]
  try { for (const e of fs.readdirSync(base, { withFileTypes: true })) if (e.isDirectory()) dirs.push(path.join(base, e.name)) } catch {}
  for (const d of dirs) {
    const file = findFile(d, name)
    if (!file) continue
    if (!others.has(file)) {
      const r = parse(file)
      others.set(file, r.status === 0 ? JSON.parse(r.stdout) : null)
    }
    if (others.get(file)) return others.get(file)
  }
  return null
}

let result
try {
  result = dsnToNetlist(JSON.parse(run.stdout), { view, resolve })
} catch (e) {
  fail(e.message, 3)
}

for (const w of result.warnings) process.stderr.write(`warning: ${w}\n`)

const csv = (v) => (/[",\n]/.test(v) ? `"${String(v).replace(/"/g, '""')}"` : String(v))
let out = result.text
if (wantBom) {
  out = ['count,value,part,footprint,refs', ...result.bom().map((r) => [r.count, r.value, r.part, r.footprint, r.refs.join(' ')].map(csv).join(','))].join('\n') + '\n'
} else if (wantJson) {
  out = JSON.stringify({ title: result.title, stats: result.stats, parts: result.parts, nets: result.nets, bom: result.bom(), warnings: result.warnings }) + '\n'
}

if (output) fs.writeFileSync(output, out)
else process.stdout.write(out)
