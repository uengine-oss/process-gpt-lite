# Process GPT Lite settings. install.sh copies this to .env (mode 0600) and fills every
# secret; edit .env afterwards and run `./install.sh --upgrade` (or `docker compose up -d`).

# ── where it runs ─────────────────────────────────────────────
COMPOSE_PROJECT_NAME=pgpt-lite
LITE_PROFILE=lite
# address the browser uses. For another PC on the network use http://<this-host-ip>:18080
# and set LITE_BIND=0.0.0.0
PUBLIC_URL=http://localhost:18080
LITE_BIND=127.0.0.1
LITE_HTTP_PORT=18080
LITE_MAIL_PORT=18025
LITE_TENANT=lite
# filled by install.sh (absolute paths)
LITE_INSTALL_DIR=
LITE_DATA_DIR=
LOOPBACK_FORWARD=

# ── sources (process-gpt-lite repository layout; install/ is this folder) ──
PGPT_SRC=..
PROCESS_GPT_SRC=../backends/process-gpt
OFFICE_HOST_SRC=../backends/office-host
# prebuilt images instead of local builds, e.g. ghcr.io/uengine-oss/process-gpt-lite
LITE_IMAGE_PREFIX=pgpt-lite
LITE_TAG=local
# 0 = no headless Chromium in the server image (browser agent off, ~300MB smaller)
WITH_BROWSER=1

# ── LLM (any OpenAI-compatible endpoint) ─────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
LLM_FAST_MODEL=gpt-4.1-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_DISPLAY_NAME=AI

# ── first administrator ──────────────────────────────────────
ADMIN_EMAIL=admin@pgpt-lite.local

# ── secrets (generated by install.sh; JWT_SECRET, ANON_KEY and SERVICE_ROLE_KEY are one set) ──
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
VAULT_KEK=
CRON_SECRET=

# ── sign-in mail: empty = the bundled mailbox at http://localhost:18025 ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Process GPT Lite
# 1 = also accept the fixed code 000000 (demos on a closed machine only)
DEMO_LOGIN=0

# ── optional integrations ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HWPX_TEMPLATE_URL=
# external services (full profile or your own): context router, memento
CONTEXT_ROUTER_URL=
# context-router's judge server (POST /judge): ranks teammates related to the work in the "@" list; empty = frequency order only
JUDGE_URL=
# meetings in a team room: transcription (OpenAI audio API key; empty = no captions/minutes text, video meeting only),
# STUN/TURN servers as JSON (empty = stun:stun.l.google.com:19302), MEETING_AGENT=0 turns the meeting assistant off
TRANSCRIBE_API_KEY=
MEETING_ICE=
MEETING_AGENT=1
BROWSER_GATES=off
MEMENTO_URL=
# process mining (optional): ./install.sh --with-mining sets LITE_MINING=1 and MINER_URL, builds
# process-miner from process-gpt feat/pgpt-lite-mining (or PROCESS_MINER_SRC, a local folder)
LITE_MINING=0
MINER_URL=
PROCESS_MINER_SRC=
# MCP_HUB_ENABLED=true makes deepagents take its MCP list from mcp-hub bindings instead of
# tenants.mcp (servers must then be registered in the hub). full sets DEEPAGENTS_PROCESS_POLLING=true.
MCP_HUB_ENABLED=false
DEEPAGENTS_PROCESS_POLLING=false
